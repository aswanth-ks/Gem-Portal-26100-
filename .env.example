# =============================================================
# GeM Portal — environment configuration (example)
# Copy to .env and fill in real values. Never commit real secrets.
# =============================================================

# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- Frontend (apps/web) ----------
VITE_API_BASE_URL=http://localhost:4000/api

# ---------- API Gateway (apps/gateway) ----------
GATEWAY_PORT=4000
GATEWAY_JWT_SECRET=change-me
GATEWAY_AI_SERVICE_URL=http://localhost:8000
GATEWAY_CORS_ORIGIN=http://localhost:5173

# ---------- AI Service (apps/ai) ----------
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development

# ---------- MongoDB (demo database) ----------
# TODO: Production target is PostgreSQL + pgvector. See ARCHITECTURE.md
# "MongoDB -> PostgreSQL/pgvector migration path" before changing this.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=gem_portal

# ---------- Security ----------
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_ISSUER_URL=
AES_256_KEY=change-me-32-bytes-min
JWT_SIGNING_ALGORITHM=RS256

# ---------- Integrations (mock adapters for demo) ----------
DIGILOCKER_API_BASE_URL=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
GEM_API_BASE_URL=
GEM_API_KEY=
GOVT_VERIFICATION_API_BASE_URL=

# ---------- AI Providers ----------
LLAMA3_ENDPOINT=
BHASHINI_API_KEY=
BHASHINI_ENDPOINT=

# ---------- Stitch (design tooling — used by Claude Code, not the app runtime) ----------
STITCH_API_KEY=
