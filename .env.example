# =============================================================
# GeM Portal — environment configuration (example)
# Copy to .env and fill in real values. Never commit real secrets.
# =============================================================

# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- Frontend (apps/web) ----------
VITE_API_BASE_URL=http://localhost:4000/api

# ---------- API Gateway (apps/gateway) ----------
GATEWAY_PORT=4000
GATEWAY_JWT_SECRET=change-me
GATEWAY_AI_SERVICE_URL=http://localhost:8000
GATEWAY_CORS_ORIGIN=http://localhost:5173
# Officers authenticate with a role=officer JWT (same GATEWAY_JWT_SECRET).
# Create an officer login: OFFICER_EMAIL=.. OFFICER_PASSWORD=.. npm run create-officer --workspace=apps/gateway

# ---------- AI Service (apps/ai) ----------
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
# Phase 4.5 — explicit provider selection ("gemini" or "ollama"), no silent fallback.
AI_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# ---------- MongoDB (demo database) ----------
# TODO: Production target is PostgreSQL + pgvector. See ARCHITECTURE.md
# "MongoDB -> PostgreSQL/pgvector migration path" before changing this.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=gem_portal

# ---------- Security ----------
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_ISSUER_URL=
AES_256_KEY=change-me-32-bytes-min
JWT_SIGNING_ALGORITHM=RS256

# ---------- Integrations (mock adapters for demo) ----------
DIGILOCKER_API_BASE_URL=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
GEM_API_BASE_URL=
GEM_API_KEY=
GOVT_VERIFICATION_API_BASE_URL=

# ---------- AI Providers ----------
LLAMA3_ENDPOINT=

# ---------- Phase 9 — BHASHINI Setu/ULCA translation (real API, not a mock) ----------
# Credentials come from the BHASHINI/Udyat dashboard ("My Profile" -> API Keys).
# BHASHINI_UDYAT_KEY authenticates the Pipeline Config call (ulcaApiKey header)
# and BHASHINI_INFERENCE_KEY authenticates the actual translation (Pipeline
# Compute) call. BHASHINI_USER_ID (userID header) is optional — only sent if
# set; confirmed live that at least one real account works without it.
# See apps/gateway/docs/bhashini.md. Never commit real values here — this
# file only ever holds empty placeholders.
BHASHINI_USER_ID=
BHASHINI_UDYAT_KEY=
BHASHINI_INFERENCE_KEY=
# Public MeitY pipeline id for the standard Dhruva translation pipeline —
# not a secret, but overridable if your dashboard issues a different one.
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# ---------- Stitch (design tooling — used by Claude Code, not the app runtime) ----------
STITCH_API_KEY=
